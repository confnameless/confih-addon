# ─────────────────────────────────────────────────────────────────────────────
# BitChord Qobuz addon — copy this file to .env and fill it in.
# Never commit .env. It contains your Qobuz account token.
# ─────────────────────────────────────────────────────────────────────────────

# ── Addon identity ───────────────────────────────────────────────────────────
ADDON_ID=app.bitchord.qobuz
ADDON_NAME=Confih Hi-Res
ADDON_VERSION=1.0.0

# Public HTTPS URL of this addon, no trailing slash. Used only to derive the
# hostname that BitChord signs for addon auth. Example:
# PUBLIC_BASE_URL=https://bitchord.confih.tech
PUBLIC_BASE_URL=

# Domain Caddy serves and gets a certificate for (docker-compose only). It must
# point at this server's public IP with an A record, and ports 80 + 443 must be
# open. Example: bitchord.confih.tech
ADDON_DOMAIN=bitchord.confih.tech

# Optional secret path prefix. If set, every route lives under /s/<secret>/.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to serve at the root. The secret is not a substitute for auth.
ADDON_PATH_SECRET=

# Recommended. Only the official BitChord Android app (1.9.1+) may call the
# addon. Requires ADDON_HOSTS or PUBLIC_BASE_URL to match the URL you paste
# into BitChord, exactly as written (hostname only).
ADDON_AUTH_ENABLED=false
ADDON_HOSTS=

# Optional traffic view. Set STATS_TOKEN to 16-128 characters of A-Z, a-z,
# 0-9, _ or - to enable GET /stats; requests need an X-Stats-Token header.
# Empty hides the endpoint. The same numbers are written to the log every
# STATS_LOG_INTERVAL_SECONDS (0 disables the periodic line).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(16))"
# STATS_TOKEN=
STATS_LOG_INTERVAL_SECONDS=60

# BitChord download permission. 1 allows downloads, 0 is streaming only.
ALLOW_DOWNLOADS=1

# Only use this addon when a lossless output is connected (wired/USB/HDMI or
# LDAC/LHDC/aptX Lossless). Usually 0 for a server addon.
CHECK_VALID_LOSSLESS=0

# How many Qobuz search rows to fetch before BitChord trims them.
SEARCH_LIMIT=25

LOG_LEVEL=INFO

# Docker uses /data. Local runs can use ./data.
DATA_DIR=./data

# ── Tidal OAuth app secrets ──────────────────────────────────────────────────
# The app *identifiers* live in app/tidal.py; their secrets are credentials and
# must come from this file. Get them the same way you got the ids — the Tidal
# clients you are entitled to use. Leave these empty to serve Qobuz only.
TIDAL_ATMOS_CLIENT_SECRET=
TIDAL_FIRE_TV_CLIENT_SECRET=
TIDAL_LEGACY_CLIENT_SECRET=

# ── Qobuz credentials ────────────────────────────────────────────────────────
# The app id/secret pair used to sign track/getFileUrl requests. The pair below
# is the one supplied for the "new token" flow. If Qobuz answers
# "Invalid Request Signature", run:
#   python3 scripts/qobuz_app_credentials.py
# and put the values it prints here.
QOBUZ_APP_ID=312369995
QOBUZ_APP_SECRET=

# Fresh user_auth_token from https://play.qobuz.com:
#   DevTools → Application → Local Storage → https://play.qobuz.com
#   → key "localuser" → copy "token" (and "id" into QOBUZ_USER_ID).
# The token is a password-equivalent secret. Do not share it.
QOBUZ_USER_AUTH_TOKEN=
QOBUZ_USER_ID=

# Optional auto-refresh. If the token is missing or expires, the addon can log
# in with your Qobuz e-mail and password. QOBUZ_PASSWORD is hashed with MD5
# before it is sent, as the Qobuz web client does. You may instead provide
# QOBUZ_PASSWORD_MD5 directly (32 hex characters).
# Leave these empty if you only want to use a browser token.
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
QOBUZ_PASSWORD_MD5=

# Optional outbound proxy for Qobuz API calls only. Required if this server's
# IP is in a country Qobuz does not serve (for example India) and you are not
# using docker-compose.vpn.yml. Audio never goes through this proxy: /stream
# returns a Qobuz CDN URL that the phone fetches directly.
# Examples:
#   QOBUZ_PROXY_URL=http://user:pass@proxy.example.com:8080
#   QOBUZ_PROXY_URL=socks5://user:pass@127.0.0.1:1080
# Leave empty when the whole addon runs behind gluetun.
QOBUZ_PROXY_URL=

# ── Free egress via Proton VPN (docker-compose.vpn.yml only) ─────────────────
# Only used by docker-compose.vpn.yml. On the Proton VPN Free plan:
#   1. Create a free account at https://account.protonvpn.com
#   2. Downloads -> WireGuard configuration -> create a config for a free
#      server in the Netherlands or the United States.
#   3. Copy only the PrivateKey value from the .conf file here.
# The key is account-wide; gluetun picks a free server in PROTON_SERVER_COUNTRIES.
# Never commit the .conf file or this key.
PROTON_WG_PRIVATE_KEY=
PROTON_SERVER_COUNTRIES=United States
PROTON_FREE_ONLY=on
# Optional narrowing if the exit IP keeps changing. Try a city before pinning a
# single hostname; Proton retires hostnames without notice. Pin only a server
# Qobuz actually accepted; some Proton exits answer Qobuz with HTTP 403.
# PROTON_SERVER_CITIES=Amsterdam
# PROTON_SERVER_HOSTNAMES=node-us-408.protonvpn.net
# Set to off only when pinning a hostname that the free-server filter hides.
# PROTON_FREE_ONLY=off

# ── Cloudflare Tunnel (docker-compose.tunnel.yml only) ──────────────────────
# The tunnel is locally-managed: credentials and ingress live in ./cloudflared,
# not in .env. That directory is ignored by git and rsync. The connector runs
# as this UID/GID so it can read the mode-400 credentials file. The Oracle
# server's ubuntu user is 1001; use 1000 on a typical desktop.
# CLOUDFLARED_UID=1000
# CLOUDFLARED_GID=1000

# ── Qobuz behaviour ──────────────────────────────────────────────────────────
QOBUZ_SELF_CHECK=true
QOBUZ_TOKEN_CHECK_INTERVAL_SECONDS=21600
QOBUZ_TIMEOUT_SECONDS=25
QOBUZ_MAX_RETRIES=2
# Global request rate to Qobuz. Raise this only if many listeners start tracks
# at the same time; Qobuz answers 429 if it is pushed too hard.
QOBUZ_RATE_LIMIT_PER_SECOND=10
QOBUZ_RATE_LIMIT_BURST=20
# In-flight Qobuz API requests. Raise for bursty multi-listener use; lower if
# Qobuz answers 429.
QOBUZ_MAX_CONCURRENCY=16

# ── Caching / limits ─────────────────────────────────────────────────────────
SEARCH_CACHE_TTL_SECONDS=600
STREAM_CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=4096
# Per-client requests per minute. Keep this generous for CGNAT: many Indian
# mobile users can share one public IPv4 address. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=600

# Set true only while debugging; exposes /docs and /openapi.json.
ENABLE_DOCS=false

# Only set true when Caddy, nginx, or a Cloudflare Tunnel is the sole way to
# reach the addon. It makes the per-client rate limit read X-Forwarded-For
# instead of seeing the proxy's IP for every listener. docker-compose.yml and
# docker-compose.vpn.yml set this automatically.
TRUST_PROXY_HEADERS=false

# Contact routes shown on /support, /about and in the footer. Leave empty and
# they are derived from the host this deployment answers on
# (support@<your-host>); set them to pin real mailboxes.
SUPPORT_EMAIL=
SECURITY_EMAIL=
ABUSE_EMAIL=
# Test deployments can opt into clearly-labelled placeholder addresses.